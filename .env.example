# Supabase (sincronização compartilhada). Sem estas variáveis o app roda só no navegador.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Qual app este build é:
#   VITE_APP=content          → hub de conteúdo (quadro, calendário, cronograma, feed, aprovação, estratégia)
#   (sem VITE_APP)            → hub de lançamentos (checklist, brief, calendário de fases)
VITE_APP=content

# Só no modo "um cliente por deploy" do hub de lançamentos: id fixo do quadro.
# Deixe vazio para o modo hub (o quadro vem da URL: /cliente).
VITE_LAUNCH_ID=
